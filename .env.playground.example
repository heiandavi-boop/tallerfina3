# PRUNIN_ARTIFACT_DIR=/ruta/a/artifacts/0.9.0-academic

# Opcional: IA generativa local. Si falla, la demo continúa con fallback fundamentado.
PRUNIN_ENABLE_OLLAMA=0
PRUNIN_OLLAMA_URL=http://localhost:11434/api/chat
PRUNIN_OLLAMA_MODEL=qwen3:8b
PORT=8000
# No se permite inferencia si llega menos del 60% de las features entrenadas.
PRUNIN_MIN_FEATURE_COVERAGE=0.60
